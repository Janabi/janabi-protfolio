# Canonical site URL (no trailing slash). Used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://janabi.github.io

# Optional: Google Search Console → HTML tag method → content="..." value only (not the full tag).
# Redeploy after setting. Then Sitemaps → submit:
# https://janabi.github.io/sitemap.xml
# (Set to your real origin: custom domain, GitHub user site root, or project subpath if you add basePath again.)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
